# Copy to .env (or export these in your process manager) and fill in real values.

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=YOUR_STEAM_API_KEY_HERE

# Public origin used to build the OpenID return_to URL. It must match the
# URL users open in the browser, including scheme and port.
APP_BASE_URL=http://localhost:8000

# Optional: override the SQLite file location.
# DB_PATH=/var/lib/steam-matchmaking/database.sqlite

# Optional: enable the seeded demo login (?demo_login=<steam id>) for local
# development and the test suite. NEVER enable this in production.
# DEMO_MODE=0
